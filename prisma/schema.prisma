// Medix by FARMAX - Prisma Schema
// PostgreSQL datasource configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// System installation & metadata model
/// Tracks system installation, schema version, and deployment identity.
model SystemInstallation {
  id              String   @id @default(uuid())
  installationKey String   @unique @map("installation_key")
  appVersion      String   @map("app_version")
  systemName      String   @default("Medix by FARMAX") @map("system_name")
  isInitialized   Boolean  @default(false) @map("is_initialized")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("system_installations")
}

/// User account model
model User {
  id                        String                @id @default(uuid())
  username                  String                @unique
  displayName               String                @map("display_name")
  passwordHash              String                @map("password_hash")
  status                    UserStatus            @default(ACTIVE)
  lastLoginAt               DateTime?             @map("last_login_at")
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")
  userRoles                 UserRole[]
  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]
  stockMovements            StockMovement[]
  postedAdjustments         StockAdjustment[]
  postedGrns                GoodsReceiveNote[]
  supplierLedgerEntries     SupplierLedgerEntry[]
  postedSalesInvoices       SalesInvoice[]        @relation("SalesInvoicePostedBy")
  cancelledSalesInvoices    SalesInvoice[]        @relation("SalesInvoiceCancelledBy")
  customerLedgerEntries     CustomerLedgerEntry[]
  postedCustomerPayments    CustomerPayment[]     @relation("CustomerPaymentPostedBy")
  cancelledCustomerPayments CustomerPayment[]     @relation("CustomerPaymentCancelledBy")
  postedSalesReturns        SalesReturn[]         @relation("SalesReturnPostedBy")
  cancelledSalesReturns     SalesReturn[]         @relation("SalesReturnCancelledBy")
  postedSupplierPayments    SupplierPayment[]     @relation("SupplierPaymentPostedBy")
  cancelledSupplierPayments SupplierPayment[]     @relation("SupplierPaymentCancelledBy")
  postedPurchaseReturns     PurchaseReturn[]      @relation("PurchaseReturnPostedBy")
  cancelledPurchaseReturns  PurchaseReturn[]      @relation("PurchaseReturnCancelledBy")
  createdStockTransfers     StockTransfer[]       @relation("StockTransferCreatedBy")
  dispatchedStockTransfers  StockTransfer[]       @relation("StockTransferDispatchedBy")
  receivedStockTransfers    StockTransfer[]       @relation("StockTransferReceivedBy")
  cancelledStockTransfers   StockTransfer[]       @relation("StockTransferCancelledBy")
  createdRecalls            ProductRecall[]       @relation("RecallCreatedBy")
  resolvedRecalls           ProductRecall[]       @relation("RecallResolvedBy")
  cancelledRecalls          ProductRecall[]       @relation("RecallCancelledBy")

  @@map("users")
}

/// RBAC Role model
model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

/// Granular RBAC Permission model
model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  description     String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

/// User to Role join model
model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Role to Permission join model
model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Client device session & refresh token model (supports multi-PC/LAN deployment)
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  deviceInfo String?   @map("device_info")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

enum DocumentType {
  SALES_INVOICE
  PURCHASE_INVOICE
  PURCHASE_ORDER
  SALES_RETURN
  PURCHASE_RETURN
  PAYMENT_RECEIPT
  GOODS_RECEIVE_NOTE
  STOCK_ADJUSTMENT
  STOCK_TRANSFER
  PRODUCT_RECALL
}

enum SettingDataType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

/// Organization / Business Profile model
model Organization {
  id                String   @id @default(uuid())
  name              String
  legalName         String?  @map("legal_name")
  address           String?
  city              String?
  state             String?
  country           String   @default("Pakistan")
  postalCode        String?  @map("postal_code")
  phone             String?
  email             String?
  website           String?
  ntn               String? // National Tax Number (Pakistani compliance)
  strn              String? // Sales Tax Registration Number
  drugSaleLicenseNo String?  @map("drug_sale_license_no") // Drug Sale License (Pakistani compliance)
  logoUrl           String?  @map("logo_url")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  branches              Branch[]
  numberingSeries       NumberingSeries[]
  systemSettings        SystemSetting[]
  manufacturers         Manufacturer[]
  productCategories     ProductCategory[]
  unitsOfMeasurement    UnitOfMeasurement[]
  products              Product[]
  warehouses            Warehouse[]
  stockMovements        StockMovement[]
  stockAdjustments      StockAdjustment[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  goodsReceiveNotes     GoodsReceiveNote[]
  supplierLedgerEntries SupplierLedgerEntry[]
  customers             Customer[]
  customerPricingRules  CustomerPricingRule[]
  customerLedgerEntries CustomerLedgerEntry[]
  salesInvoices         SalesInvoice[]
  customerPayments      CustomerPayment[]
  salesReturns          SalesReturn[]
  supplierPayments      SupplierPayment[]
  purchaseReturns       PurchaseReturn[]
  promotionalSchemes    PromotionalScheme[]
  stockTransfers        StockTransfer[]
  productRecalls        ProductRecall[]

  @@map("organizations")
}

/// Branch model
model Branch {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String // e.g. "HO", "BR01"
  address        String?
  city           String?
  phone          String?
  email          String?
  isHeadOffice   Boolean  @default(false) @map("is_head_office")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  numberingSeries       NumberingSeries[]
  warehouses            Warehouse[]
  stockMovements        StockMovement[]
  stockAdjustments      StockAdjustment[]
  purchaseOrders        PurchaseOrder[]
  goodsReceiveNotes     GoodsReceiveNote[]
  supplierLedgerEntries SupplierLedgerEntry[]
  customerLedgerEntries CustomerLedgerEntry[]
  salesInvoices         SalesInvoice[]
  customerPayments      CustomerPayment[]
  salesReturns          SalesReturn[]
  supplierPayments      SupplierPayment[]
  purchaseReturns       PurchaseReturn[]
  stockTransfers        StockTransfer[]

  @@unique([organizationId, code])
  @@map("branches")
}

/// Numbering Series model for document sequential numbering
model NumberingSeries {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  branchId       String?      @map("branch_id")
  documentType   DocumentType @map("document_type")
  prefix         String
  suffix         String?
  nextNumber     Int          @default(1) @map("next_number")
  padding        Int          @default(5)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([organizationId, branchId, documentType])
  @@map("numbering_series")
}

/// System Setting key/value typed storage model
model SystemSetting {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  key            String
  value          String
  dataType       SettingDataType @default(STRING) @map("data_type")
  group          String          @default("GENERAL")
  description    String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("system_settings")
}

/// Audit Log model for recording security and business operations
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum BatchStatus {
  ACTIVE
  QUARANTINED
  RECALLED
}

/// Pharmaceutical Manufacturer / Principal model
model Manufacturer {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String?
  contactPerson  String?  @map("contact_person")
  phone          String?
  email          String?
  address        String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, name])
  @@map("manufacturers")
}

/// Product Category model (e.g. Antibiotics, Analgesics, Cardiac, OTC)
model ProductCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String?
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, name])
  @@map("product_categories")
}

/// Unit of Measurement model (e.g. Box, Strip, Bottle, Ampoule, Vial)
model UnitOfMeasurement {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  symbol         String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, symbol])
  @@map("units_of_measurement")
}

/// Pharmaceutical Product / SKU Master model
model Product {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  sku            String // User-defined SKU / Item Code
  name           String // Commercial Brand Name e.g. "Panadol 500mg"
  genericName    String   @map("generic_name") // e.g. "Paracetamol"
  manufacturerId String?  @map("manufacturer_id")
  categoryId     String?  @map("category_id")
  unitId         String?  @map("unit_id")
  dosageForm     String?  @map("dosage_form") // Flexible string e.g. "Tablet", "Syrup"
  strength       String? // e.g. "500mg", "250mg/5ml"
  packSize       String?  @map("pack_size") // e.g. "10x10", "1x60ml"
  barcode        String?
  taxPercentage  Decimal  @default(0.00) @map("tax_percentage") @db.Decimal(5, 2)
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  manufacturer            Manufacturer?          @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  category                ProductCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit                    UnitOfMeasurement?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  batches                 Batch[]
  stockMovements          StockMovement[]
  stockAdjustmentItems    StockAdjustmentItem[]
  purchaseOrderItems      PurchaseOrderItem[]
  goodsReceiveNoteItems   GoodsReceiveNoteItem[]
  salesInvoiceItems       SalesInvoiceItem[]
  customerPricingRules    CustomerPricingRule[]
  salesReturnItems        SalesReturnItem[]
  purchaseReturnItems     PurchaseReturnItem[]
  promotionalSchemes      PromotionalScheme[]    @relation("SchemeProduct")
  bonusPromotionalSchemes PromotionalScheme[]    @relation("SchemeBonusProduct")
  stockTransferItems      StockTransferItem[]
  productRecalls          ProductRecall[]

  @@unique([organizationId, sku])
  @@index([organizationId, name])
  @@index([organizationId, genericName])
  @@index([organizationId, barcode])
  @@map("products")
}

/// Pharmaceutical Batch / Lot model
model Batch {
  id           String      @id @default(uuid())
  productId    String      @map("product_id")
  batchNumber  String      @map("batch_number") // e.g. "BN-99201"
  mfgDate      DateTime?   @map("mfg_date")
  expiryDate   DateTime    @map("expiry_date")
  purchaseCost Decimal     @map("purchase_cost") @db.Decimal(12, 2)
  tradePrice   Decimal     @map("trade_price") @db.Decimal(12, 2) // TP (Regulated Trade Price)
  retailPrice  Decimal     @map("retail_price") @db.Decimal(12, 2) // MRP (Max Retail Price)
  status       BatchStatus @default(ACTIVE)
  remarks      String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements        StockMovement[]
  stockAdjustmentItems  StockAdjustmentItem[]
  goodsReceiveNoteItems GoodsReceiveNoteItem[]
  salesInvoiceItems     SalesInvoiceItem[]
  salesReturnItems      SalesReturnItem[]
  purchaseReturnItems   PurchaseReturnItem[]
  stockTransferItems    StockTransferItem[]
  productRecalls        ProductRecall[]

  @@unique([productId, batchNumber])
  @@index([productId, expiryDate])
  @@index([status])
  @@map("batches")
}

enum WarehouseType {
  STANDARD // Dispensary, main distribution shelf, active picking area
  QUARANTINE // Damaged, expired, cold-chain compromised, customer-returned quarantine
}

/// Warehouse / Storage Location model (anchored to Branch)
model Warehouse {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  branchId       String        @map("branch_id")
  name           String // e.g. "Main Warehouse", "Quarantine Section"
  code           String // e.g. "WH-MAIN", "WH-QUAR"
  address        String?
  warehouseType  WarehouseType @default(STANDARD) @map("warehouse_type")
  isDefault      Boolean       @default(false) @map("is_default")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization              Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch                    Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stockMovements            StockMovement[]
  stockAdjustments          StockAdjustment[]
  goodsReceiveNotes         GoodsReceiveNote[]
  salesInvoices             SalesInvoice[]
  salesReturnItems          SalesReturnItem[]
  purchaseReturnItems       PurchaseReturnItem[]
  sourceStockTransfers      StockTransfer[]      @relation("SourceStockTransfers")
  destinationStockTransfers StockTransfer[]      @relation("DestinationStockTransfers")

  @@unique([branchId, code])
  @@map("warehouses")
}

enum StockMovementType {
  OPENING_BALANCE // Initial system bootstrap / stock setup (+)
  STOCK_ADJUSTMENT_IN // Physical count positive variance (+)
  STOCK_ADJUSTMENT_OUT // Physical count negative variance / damage / disposal (-)
  TRANSFER_IN // Internal warehouse receiving (+) [Reserved]
  TRANSFER_OUT // Internal warehouse dispatch (-) [Reserved]
  PURCHASE_RECEIPT // Supplier GRN receiving (+)
  PURCHASE_RETURN // Vendor return debit note (-) [Reserved]
  SALES_ISSUE // Customer invoice delivery (-) [Reserved]
  SALES_RETURN // Customer sales return credit note (+) [Reserved]
}

/// Immutable Stock Movement Ledger
model StockMovement {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  branchId        String            @map("branch_id")
  warehouseId     String            @map("warehouse_id")
  productId       String            @map("product_id")
  batchId         String            @map("batch_id")
  movementType    StockMovementType @map("movement_type")
  quantity        Int // Signed: positive for inflow (+), negative for outflow (-)
  unitCost        Decimal           @map("unit_cost") @db.Decimal(12, 2)
  referenceType   String            @map("reference_type") // e.g. "STOCK_ADJUSTMENT", "OPENING_BALANCE", "GOODS_RECEIVE_NOTE"
  referenceId     String?           @map("reference_id") // ID of source document
  movementDate    DateTime          @default(now()) @map("movement_date")
  notes           String?
  createdByUserId String?           @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch         Batch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  createdByUser User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, branchId, warehouseId])
  @@index([productId, batchId])
  @@index([movementDate])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

enum StockAdjustmentReason {
  INITIAL_COUNT
  PHYSICAL_INVENTORY_VARIANCE
  DAMAGED_EXPIRED_DISPOSAL
  PILFERAGE_LOSS
  CORRECTION
}

enum StockAdjustmentStatus {
  DRAFT
  POSTED
  CANCELLED
}

/// Auditable Stock Adjustment Document
model StockAdjustment {
  id               String                @id @default(uuid())
  organizationId   String                @map("organization_id")
  branchId         String                @map("branch_id")
  warehouseId      String                @map("warehouse_id")
  adjustmentNumber String                @map("adjustment_number") // Sequential via NumberingService (DocumentType.STOCK_ADJUSTMENT)
  reason           StockAdjustmentReason
  status           StockAdjustmentStatus @default(DRAFT)
  notes            String?
  postedAt         DateTime?             @map("posted_at")
  postedByUserId   String?               @map("posted_by_user_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse    Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  postedByUser User?                 @relation(fields: [postedByUserId], references: [id], onDelete: SetNull)
  items        StockAdjustmentItem[]

  @@unique([organizationId, adjustmentNumber])
  @@index([branchId, warehouseId])
  @@map("stock_adjustments")
}

/// Stock Adjustment Line Item (records Counted vs Current Variance)
model StockAdjustmentItem {
  id           String  @id @default(uuid())
  adjustmentId String  @map("adjustment_id")
  productId    String  @map("product_id")
  batchId      String  @map("batch_id")
  quantity     Int // Variance quantity (counted - current): positive (+) for increase, negative (-) for decrease
  unitCost     Decimal @map("unit_cost") @db.Decimal(12, 2)
  remarks      String?

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch      Batch           @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@map("stock_adjustment_items")
}

// -----------------------------------------------------------------------------
// PURCHASING, SUPPLIER & GOODS RECEIVING (GRN) MODELS
// -----------------------------------------------------------------------------

/// Supplier / Vendor Master Model
model Supplier {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String // e.g. "SUP-001" (unique per organization)
  name           String // e.g. "Getz Pharma Distribution"
  contactPerson  String?  @map("contact_person")
  phone          String?
  email          String?
  address        String?
  city           String?
  ntn            String? // National Tax Number (Pakistani compliance)
  strn           String? // Sales Tax Registration Number
  drugLicenseNo  String?  @map("drug_license_no") // Drug Sale License
  creditDays     Int      @default(30) @map("credit_days")
  creditLimit    Decimal  @default(0.00) @map("credit_limit") @db.Decimal(12, 2)
  currentBalance Decimal  @default(0.00) @map("current_balance") @db.Decimal(12, 2) // Cached organization-wide payable balance
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrders    PurchaseOrder[]
  goodsReceiveNotes GoodsReceiveNote[]
  ledgerEntries     SupplierLedgerEntry[]
  supplierPayments  SupplierPayment[]
  purchaseReturns   PurchaseReturn[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@index([organizationId, isActive])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Purchase Order (Commercial Intent / Order Document)
model PurchaseOrder {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  branchId       String              @map("branch_id")
  supplierId     String              @map("supplier_id")
  poNumber       String              @map("po_number") // Sequential via NumberingService (DocumentType.PURCHASE_ORDER)
  orderDate      DateTime            @default(now()) @map("order_date")
  expectedDate   DateTime?           @map("expected_date")
  status         PurchaseOrderStatus @default(DRAFT)
  subtotal       Decimal             @default(0.00) @map("subtotal") @db.Decimal(12, 2)
  taxAmount      Decimal             @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal             @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  netTotal       Decimal             @default(0.00) @map("net_total") @db.Decimal(12, 2)
  notes          String?
  createdById    String?             @map("created_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items             PurchaseOrderItem[]
  goodsReceiveNotes GoodsReceiveNote[]

  @@unique([organizationId, poNumber])
  @@index([organizationId, branchId, supplierId])
  @@index([status])
  @@map("purchase_orders")
}

/// Purchase Order Line Item
model PurchaseOrderItem {
  id                 String  @id @default(uuid())
  purchaseOrderId    String  @map("purchase_order_id")
  productId          String  @map("product_id")
  orderedQuantity    Int     @map("ordered_quantity")
  receivedQuantity   Int     @default(0) @map("received_quantity")
  unitCost           Decimal @map("unit_cost") @db.Decimal(12, 2)
  discountPercentage Decimal @default(0.00) @map("discount_percentage") @db.Decimal(5, 2)
  taxPercentage      Decimal @default(0.00) @map("tax_percentage") @db.Decimal(5, 2)
  lineTotal          Decimal @map("line_total") @db.Decimal(12, 2)
  remarks            String?

  purchaseOrder PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  grnItems      GoodsReceiveNoteItem[]

  @@map("purchase_order_items")
}

enum GrnStatus {
  DRAFT
  POSTED
  CANCELLED
}

/// Goods Receive Note (Physical Receiving, Stock Ledger & Payable Billing)
model GoodsReceiveNote {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  branchId              String    @map("branch_id")
  warehouseId           String    @map("warehouse_id")
  supplierId            String    @map("supplier_id")
  purchaseOrderId       String?   @map("purchase_order_id") // Optional link to PO
  grnNumber             String    @map("grn_number") // Sequential via NumberingService (DocumentType.GOODS_RECEIVE_NOTE)
  supplierInvoiceNumber String?   @map("supplier_invoice_number") // Vendor's delivery bill / invoice number
  supplierInvoiceDate   DateTime? @map("supplier_invoice_date")
  receivedDate          DateTime  @default(now()) @map("received_date")
  status                GrnStatus @default(DRAFT)
  subtotal              Decimal   @default(0.00) @map("subtotal") @db.Decimal(12, 2)
  taxAmount             Decimal   @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount        Decimal   @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  netTotal              Decimal   @default(0.00) @map("net_total") @db.Decimal(12, 2)
  paidAmount            Decimal   @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount         Decimal   @default(0.00) @map("balance_amount") @db.Decimal(12, 2)
  notes                 String?
  postedAt              DateTime? @map("posted_at")
  postedByUserId        String?   @map("posted_by_user_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch             Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse          Warehouse                   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplier           Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder      PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  postedByUser       User?                       @relation(fields: [postedByUserId], references: [id], onDelete: SetNull)
  items              GoodsReceiveNoteItem[]
  ledgerEntries      SupplierLedgerEntry[]
  paymentAllocations SupplierPaymentAllocation[]
  purchaseReturns    PurchaseReturn[]

  @@unique([organizationId, grnNumber])
  @@index([organizationId, branchId, warehouseId])
  @@index([supplierId, status])
  @@index([receivedDate])
  @@map("goods_receive_notes")
}

/// Goods Receive Note Line Item (Batch capture & itemized cost)
model GoodsReceiveNoteItem {
  id                 String    @id @default(uuid())
  grnId              String    @map("grn_id")
  poItemId           String?   @map("po_item_id")
  productId          String    @map("product_id")
  batchId            String?   @map("batch_id") // Assigned / Created upon receiving
  batchNumber        String    @map("batch_number")
  mfgDate            DateTime? @map("mfg_date")
  expiryDate         DateTime  @map("expiry_date")
  receivedQuantity   Int       @map("received_quantity") // Billed Units received
  bonusQuantity      Int       @default(0) @map("bonus_quantity") // Free / Bonus units from vendor (0 cost)
  unitCost           Decimal   @map("unit_cost") @db.Decimal(12, 2) // Received purchase price per unit snapshot
  tradePrice         Decimal   @map("trade_price") @db.Decimal(12, 2) // Regulated TP snapshot
  retailPrice        Decimal   @map("retail_price") @db.Decimal(12, 2) // Regulated MRP snapshot
  discountPercentage Decimal   @default(0.00) @map("discount_percentage") @db.Decimal(5, 2)
  taxPercentage      Decimal   @default(0.00) @map("tax_percentage") @db.Decimal(5, 2)
  lineTotal          Decimal   @map("line_total") @db.Decimal(12, 2) // (receivedQty * unitCost) - discount + tax
  remarks            String?

  grn                 GoodsReceiveNote     @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItem              PurchaseOrderItem?   @relation(fields: [poItemId], references: [id], onDelete: SetNull)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch               Batch?               @relation(fields: [batchId], references: [id], onDelete: Restrict)
  purchaseReturnItems PurchaseReturnItem[]

  @@map("goods_receive_note_items")
}

enum SupplierLedgerEntryType {
  OPENING_BALANCE // Initial vendor balance setup
  GRN_INVOICE // Goods receipt bill / payable addition (Credit)
  PAYMENT // Vendor payment / bank disbursement (Debit)
  DEBIT_NOTE // Purchase return / vendor debit (Debit)
  ADJUSTMENT // Balance correction
}

/// Immutable Supplier Financial Sub-Ledger Entry
model SupplierLedgerEntry {
  id                String                  @id @default(uuid())
  organizationId    String                  @map("organization_id")
  branchId          String                  @map("branch_id")
  supplierId        String                  @map("supplier_id")
  grnId             String?                 @map("grn_id")
  supplierPaymentId String?                 @map("supplier_payment_id")
  purchaseReturnId  String?                 @map("purchase_return_id")
  entryType         SupplierLedgerEntryType @map("entry_type")
  referenceNumber   String                  @map("reference_number") // e.g. "GRN-00042", "OPENING", or "INV-8891"
  debit             Decimal                 @default(0.00) @db.Decimal(12, 2) // Reduces payable (Payments, Returns)
  credit            Decimal                 @default(0.00) @db.Decimal(12, 2) // Increases payable (Purchases/GRN)
  runningBalance    Decimal                 @map("running_balance") @db.Decimal(12, 2)
  transactionDate   DateTime                @default(now()) @map("transaction_date")
  notes             String?
  createdByUserId   String?                 @map("created_by_user_id")
  createdAt         DateTime                @default(now()) @map("created_at")

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier        Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  grn             GoodsReceiveNote? @relation(fields: [grnId], references: [id], onDelete: SetNull)
  supplierPayment SupplierPayment?  @relation(fields: [supplierPaymentId], references: [id], onDelete: SetNull)
  purchaseReturn  PurchaseReturn?   @relation(fields: [purchaseReturnId], references: [id], onDelete: SetNull)
  createdByUser   User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, supplierId, transactionDate])
  @@index([grnId])
  @@index([supplierPaymentId])
  @@index([purchaseReturnId])
  @@map("supplier_ledger_entries")
}

// ==========================================
// SUPPLIER PAYMENTS & SETTLEMENT MODELS
// ==========================================

enum SupplierPaymentStatus {
  POSTED
  CANCELLED
}

/// Standalone Supplier Payment / Disbursement Document
model SupplierPayment {
  id                String        @id @default(uuid())
  organizationId    String        @map("organization_id")
  branchId          String        @map("branch_id")
  supplierId        String        @map("supplier_id")
  paymentNumber     String        @map("payment_number") // Sequential (DocumentType.PAYMENT_RECEIPT)
  paymentDate       DateTime      @default(now()) @map("payment_date")
  paymentMethod     PaymentMethod @map("payment_method")
  amount            Decimal       @db.Decimal(12, 2)
  allocatedAmount   Decimal       @default(0.00) @map("allocated_amount") @db.Decimal(12, 2)
  unallocatedAmount Decimal       @default(0.00) @map("unallocated_amount") @db.Decimal(12, 2)

  referenceNumber String?               @map("reference_number")
  bankName        String?               @map("bank_name")
  chequeDate      DateTime?             @map("cheque_date")
  notes           String?
  status          SupplierPaymentStatus @default(POSTED)

  postedAt           DateTime  @default(now()) @map("posted_at")
  postedByUserId     String?   @map("posted_by_user_id")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledByUserId  String?   @map("cancelled_by_user_id")
  cancellationReason String?   @map("cancellation_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier        Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  postedByUser    User?        @relation("SupplierPaymentPostedBy", fields: [postedByUserId], references: [id], onDelete: SetNull)
  cancelledByUser User?        @relation("SupplierPaymentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  allocations   SupplierPaymentAllocation[]
  ledgerEntries SupplierLedgerEntry[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, supplierId, paymentDate])
  @@map("supplier_payments")
}

/// GRN Allocation breakdown for supplier payments
model SupplierPaymentAllocation {
  id                String   @id @default(uuid())
  supplierPaymentId String   @map("supplier_payment_id")
  grnId             String   @map("grn_id")
  amountAllocated   Decimal  @map("amount_allocated") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  supplierPayment SupplierPayment  @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  grn             GoodsReceiveNote @relation(fields: [grnId], references: [id], onDelete: Restrict)

  @@index([supplierPaymentId])
  @@index([grnId])
  @@map("supplier_payment_allocations")
}

// ==========================================
// PURCHASE RETURNS & DEBIT NOTE MODELS
// ==========================================

enum PurchaseReturnStatus {
  POSTED
  CANCELLED
}

enum PurchaseReturnReason {
  DAMAGED_GOODS
  DEFECTIVE_BATCH
  NEAR_EXPIRY_RECALL
  OVER_DELIVERY
  WRONG_PRODUCT
  REGULATORY_RECALL
  OTHER
}

/// Purchase Return / Vendor Debit Note Header
model PurchaseReturn {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  branchId       String               @map("branch_id")
  supplierId     String               @map("supplier_id")
  grnId          String               @map("grn_id")
  returnNumber   String               @map("return_number") // Sequential (DocumentType.PURCHASE_RETURN)
  returnDate     DateTime             @default(now()) @map("return_date")
  status         PurchaseReturnStatus @default(POSTED)
  reason         PurchaseReturnReason @default(DAMAGED_GOODS)

  subtotal       Decimal @default(0.00) @map("subtotal") @db.Decimal(12, 2)
  discountAmount Decimal @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  netTotal       Decimal @default(0.00) @map("net_total") @db.Decimal(12, 2)

  notes              String?
  postedAt           DateTime  @default(now()) @map("posted_at")
  postedByUserId     String?   @map("posted_by_user_id")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledByUserId  String?   @map("cancelled_by_user_id")
  cancellationReason String?   @map("cancellation_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  grn             GoodsReceiveNote @relation(fields: [grnId], references: [id], onDelete: Restrict)
  postedByUser    User?            @relation("PurchaseReturnPostedBy", fields: [postedByUserId], references: [id], onDelete: SetNull)
  cancelledByUser User?            @relation("PurchaseReturnCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  items         PurchaseReturnItem[]
  ledgerEntries SupplierLedgerEntry[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId, branchId, returnDate])
  @@index([grnId])
  @@index([supplierId])
  @@map("purchase_returns")
}

/// Purchase Return Line Item (Discrete batch deducted from source warehouse location)
model PurchaseReturnItem {
  id                String   @id @default(uuid())
  purchaseReturnId  String   @map("purchase_return_id")
  grnItemId         String   @map("grn_item_id")
  productId         String   @map("product_id")
  batchId           String   @map("batch_id")
  batchNumber       String   @map("batch_number")
  expiryDate        DateTime @map("expiry_date")
  sourceWarehouseId String   @map("source_warehouse_id")

  returnedQuantity      Int @map("returned_quantity")
  bonusReturnedQuantity Int @default(0) @map("bonus_returned_quantity")
  totalReturnedQuantity Int @map("total_returned_quantity")

  stockCondition     ReturnedStockCondition @default(SALEABLE) @map("stock_condition")
  unitCost           Decimal                @map("unit_cost") @db.Decimal(12, 2)
  discountPercentage Decimal                @default(0.00) @map("discount_percentage") @db.Decimal(5, 2)
  discountAmount     Decimal                @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxPercentage      Decimal                @default(0.00) @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount          Decimal                @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal          Decimal                @map("line_total") @db.Decimal(12, 2)

  purchaseReturn  PurchaseReturn       @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  grnItem         GoodsReceiveNoteItem @relation(fields: [grnItemId], references: [id], onDelete: Restrict)
  product         Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch           Batch                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sourceWarehouse Warehouse            @relation(fields: [sourceWarehouseId], references: [id], onDelete: Restrict)

  @@index([purchaseReturnId])
  @@index([grnItemId])
  @@map("purchase_return_items")
}

// ==========================================
// CUSTOMER & SUB-LEDGER MODELS
// ==========================================

enum CustomerType {
  RETAIL_PHARMACY // B2B Retail Pharmacy
  HOSPITAL // B2B Hospital / Clinic
  DISTRIBUTOR // B2B Sub-distributor
  WALK_IN // B2C Walk-in Cash Customer
  INSTITUTIONAL // Government / NGO / Corporate
}

/// Customer Master Data model
model Customer {
  id                        String       @id @default(uuid())
  organizationId            String       @map("organization_id")
  code                      String // Unique per organization (e.g. "CUST-00101")
  name                      String // Commercial name (e.g. "Al-Shifa Pharmacy")
  customerType              CustomerType @default(RETAIL_PHARMACY) @map("customer_type")
  contactPerson             String?      @map("contact_person")
  phone                     String?
  email                     String?
  address                   String?
  city                      String?
  ntn                       String? // National Tax Number
  strn                      String? // Sales Tax Registration Number
  drugSaleLicenseNo         String?      @map("drug_sale_license_no") // Regulatory compliance
  creditDays                Int          @default(0) @map("credit_days") // 0 = Strict Cash
  creditLimit               Decimal      @default(0.00) @map("credit_limit") @db.Decimal(12, 2)
  currentBalance            Decimal      @default(0.00) @map("current_balance") @db.Decimal(12, 2) // Cached total receivable balance
  defaultDiscountPercentage Decimal      @default(0.00) @map("default_discount_percentage") @db.Decimal(5, 2)
  isTaxExempt               Boolean      @default(false) @map("is_tax_exempt")
  isActive                  Boolean      @default(true) @map("is_active")
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesInvoices      SalesInvoice[]
  ledgerEntries      CustomerLedgerEntry[]
  pricingRules       CustomerPricingRule[]
  customerPayments   CustomerPayment[]
  salesReturns       SalesReturn[]
  promotionalSchemes PromotionalScheme[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@index([organizationId, phone])
  @@map("customers")
}

/// Customer-Specific Pricing Overrides (contracted rates or custom discounts)
model CustomerPricingRule {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  customerId         String    @map("customer_id")
  productId          String    @map("product_id")
  customPrice        Decimal?  @map("custom_price") @db.Decimal(12, 2) // Fixed contracted unit price
  discountPercentage Decimal?  @map("discount_percentage") @db.Decimal(5, 2) // Contracted discount %
  minQuantity        Int       @default(1) @map("min_quantity") // Minimum billed quantity required to trigger
  startDate          DateTime? @map("start_date") // Optional effective start date
  endDate            DateTime? @map("end_date") // Optional effective end date
  notes              String?
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@index([organizationId, productId])
  @@map("customer_pricing_rules")
}

enum SchemeType {
  BUY_X_GET_Y_FREE // e.g. Buy 10 of Product A, Get 1 of Product A (or B) free
  BUY_X_GET_DISCOUNT // e.g. Buy 10 or more, get 15% off
  FLAT_DISCOUNT_PERCENT // e.g. Special promotional discount % on product
  FLAT_PRICE_OVERRIDE // e.g. Fixed promotional promo price
}

/// Promotional & Bonus Schemes Model (Pharma commercial trade schemes)
model PromotionalScheme {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  name           String // e.g. "Augmentin Monsoon Special (10+1)"
  code           String // e.g. "SCH-AUG-10P1"
  description    String?
  schemeType     SchemeType @default(BUY_X_GET_Y_FREE) @map("scheme_type")

  // Product scope
  productId String @map("product_id")

  // Scheme parameters
  minQuantity        Int      @default(1) @map("min_quantity") // "Buy X" threshold (e.g. 10)
  bonusQuantity      Int      @default(0) @map("bonus_quantity") // "Get Y Free" (e.g. 1)
  bonusProductId     String?  @map("bonus_product_id") // Optional free product (defaults to same product if null)
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  overridePrice      Decimal? @map("override_price") @db.Decimal(12, 2)

  // Customer eligibility (optional customer or customer category filter)
  customerId   String?       @map("customer_id") // Specific customer if restricted, or null for all
  customerType CustomerType? @map("customer_type") // Specific customer category if restricted, or null for all

  // Validity window
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation("SchemeProduct", fields: [productId], references: [id], onDelete: Cascade)
  bonusProduct Product?     @relation("SchemeBonusProduct", fields: [bonusProductId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, productId, isActive])
  @@index([startDate, endDate])
  @@map("promotional_schemes")
}

enum CustomerLedgerEntryType {
  OPENING_BALANCE // Initial receivable balance setup
  SALES_INVOICE // Invoice issued / receivable addition (Debit)
  PAYMENT // Customer payment at checkout or standalone receipt (Credit)
  CREDIT_NOTE // Sales invoice cancellation or sales return (Credit)
  REFUND // Cash/bank refund payout (Debit)
  ADJUSTMENT // Balance correction or cancellation reversal
}

/// Immutable Customer Financial Sub-Ledger Entry
model CustomerLedgerEntry {
  id                String                  @id @default(uuid())
  organizationId    String                  @map("organization_id")
  branchId          String                  @map("branch_id")
  customerId        String                  @map("customer_id")
  salesInvoiceId    String?                 @map("sales_invoice_id")
  customerPaymentId String?                 @map("customer_payment_id")
  salesReturnId     String?                 @map("sales_return_id")
  entryType         CustomerLedgerEntryType @map("entry_type")
  referenceNumber   String                  @map("reference_number") // e.g. "INV-00102", "REC-00045", "SRET-00001"
  debit             Decimal                 @default(0.00) @db.Decimal(12, 2) // Increases receivable
  credit            Decimal                 @default(0.00) @db.Decimal(12, 2) // Decreases receivable
  runningBalance    Decimal                 @map("running_balance") @db.Decimal(12, 2)
  transactionDate   DateTime                @default(now()) @map("transaction_date")
  notes             String?
  createdByUserId   String?                 @map("created_by_user_id")
  createdAt         DateTime                @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesInvoice    SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  customerPayment CustomerPayment? @relation(fields: [customerPaymentId], references: [id], onDelete: SetNull)
  salesReturn     SalesReturn?     @relation(fields: [salesReturnId], references: [id], onDelete: SetNull)
  createdByUser   User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId, transactionDate])
  @@index([salesInvoiceId])
  @@index([customerPaymentId])
  @@index([salesReturnId])
  @@map("customer_ledger_entries")
}

// ==========================================
// SALES INVOICE & DISPENSING MODELS
// ==========================================

enum SalesInvoiceStatus {
  DRAFT // Unposted quotation / parked bill (no stock deducted, no number consumed)
  POSTED // Immutable finalized sale (stock deducted, invoice number assigned, ledger updated)
  CANCELLED // Formally voided/cancelled (stock restored, ledger reversed)
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  CHEQUE
  ONLINE
  CREDIT_ACCOUNT // Billed to customer credit account
}

/// Sales Invoice Header
model SalesInvoice {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  branchId       String             @map("branch_id")
  warehouseId    String             @map("warehouse_id")
  customerId     String             @map("customer_id")
  invoiceNumber  String?            @map("invoice_number") // Null in DRAFT, generated on POSTED via NumberingService
  draftNumber    String?            @map("draft_number") // Temporary identifier for parked drafts (e.g. "DFT-00102")
  invoiceDate    DateTime           @default(now()) @map("invoice_date")
  status         SalesInvoiceStatus @default(DRAFT)
  paymentMethod  PaymentMethod      @default(CASH) @map("payment_method")

  // Financial Totals
  subtotal       Decimal @default(0.00) @map("subtotal") @db.Decimal(12, 2) // Sum of gross lines
  discountAmount Decimal @default(0.00) @map("discount_amount") @db.Decimal(12, 2) // Total line & invoice discount
  taxAmount      Decimal @default(0.00) @map("tax_amount") @db.Decimal(12, 2) // Total GST/Sales tax
  netTotal       Decimal @default(0.00) @map("net_total") @db.Decimal(12, 2) // Total amount payable
  paidAmount     Decimal @default(0.00) @map("paid_amount") @db.Decimal(12, 2) // Sum of checkout tenders & payment allocations
  balanceAmount  Decimal @default(0.00) @map("balance_amount") @db.Decimal(12, 2) // Net outstanding (strictly >= 0)
  totalCostPrice Decimal @default(0.00) @map("total_cost_price") @db.Decimal(12, 2) // Total COGS snapshot
  grossProfit    Decimal @default(0.00) @map("gross_profit") @db.Decimal(12, 2) // (netTotal - taxAmount) - totalCostPrice

  notes              String?
  postedAt           DateTime? @map("posted_at")
  postedByUserId     String?   @map("posted_by_user_id")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledByUserId  String?   @map("cancelled_by_user_id")
  cancellationReason String?   @map("cancellation_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse       Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  postedByUser    User?        @relation("SalesInvoicePostedBy", fields: [postedByUserId], references: [id], onDelete: SetNull)
  cancelledByUser User?        @relation("SalesInvoiceCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  items              SalesInvoiceItem[]
  payments           SalesInvoicePayment[]
  ledgerEntries      CustomerLedgerEntry[]
  paymentAllocations CustomerPaymentAllocation[]
  salesReturns       SalesReturn[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, branchId, invoiceDate])
  @@index([customerId, status])
  @@map("sales_invoices")
}

/// Sales Invoice Line Item (Exact batch dispensed with authoritative acquisition cost)
model SalesInvoiceItem {
  id             String   @id @default(uuid())
  salesInvoiceId String   @map("sales_invoice_id")
  productId      String   @map("product_id")
  batchId        String   @map("batch_id")
  batchNumber    String   @map("batch_number")
  expiryDate     DateTime @map("expiry_date")

  billedQuantity Int @map("billed_quantity") // Units billed to customer
  bonusQuantity  Int @default(0) @map("bonus_quantity") // Free/bonus units dispensed (0 revenue charge)
  totalQuantity  Int @map("total_quantity") // billedQuantity + bonusQuantity (physical units deducted)

  unitCost           Decimal @map("unit_cost") @db.Decimal(12, 2) // Batch acquisition cost snapshot (COGS)
  tradePrice         Decimal @map("trade_price") @db.Decimal(12, 2) // TP snapshot
  retailPrice        Decimal @map("retail_price") @db.Decimal(12, 2) // MRP snapshot
  unitPrice          Decimal @map("unit_price") @db.Decimal(12, 2) // Resolved unit price before line discount
  discountPercentage Decimal @default(0.00) @map("discount_percentage") @db.Decimal(5, 2)
  discountAmount     Decimal @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxPercentage      Decimal @default(0.00) @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount          Decimal @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal          Decimal @map("line_total") @db.Decimal(12, 2) // (billedQuantity * unitPrice) - discount + tax
  lineCost           Decimal @map("line_cost") @db.Decimal(12, 2) // totalQuantity * unitCost (COGS)
  lineProfit         Decimal @map("line_profit") @db.Decimal(12, 2) // (lineTotal - taxAmount) - lineCost

  // Auditable pricing and scheme snapshot
  pricingSource String? @map("pricing_source") // e.g. CUSTOMER_CUSTOM_PRICE, CUSTOMER_PRODUCT_DISCOUNT, PROMOTIONAL_SCHEME, etc.
  pricingRuleId String? @map("pricing_rule_id")
  schemeId      String? @map("scheme_id")
  schemeName    String? @map("scheme_name")

  salesInvoice     SalesInvoice      @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch            Batch             @relation(fields: [batchId], references: [id], onDelete: Restrict)
  salesReturnItems SalesReturnItem[]

  @@index([salesInvoiceId])
  @@index([productId, batchId])
  @@map("sales_invoice_items")
}

/// Point-of-Sale Checkout Tender Record (Invoice settlement breakdown)
model SalesInvoicePayment {
  id              String        @id @default(uuid())
  salesInvoiceId  String        @map("sales_invoice_id")
  paymentMethod   PaymentMethod @map("payment_method")
  amount          Decimal       @db.Decimal(12, 2)
  referenceNumber String?       @map("reference_number") // Cheque #, card slip auth, bank transfer ref
  notes           String?
  paidAt          DateTime      @default(now()) @map("paid_at")

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@map("sales_invoice_payments")
}

// ==========================================
// CUSTOMER PAYMENTS & STANDALONE RECEIPTS
// ==========================================

enum CustomerPaymentStatus {
  POSTED
  CANCELLED
}

/// Standalone Customer Payment / Receipt Document
model CustomerPayment {
  id                String        @id @default(uuid())
  organizationId    String        @map("organization_id")
  branchId          String        @map("branch_id")
  customerId        String        @map("customer_id")
  paymentNumber     String        @map("payment_number") // Sequential (DocumentType.PAYMENT_RECEIPT)
  paymentDate       DateTime      @default(now()) @map("payment_date")
  paymentMethod     PaymentMethod @map("payment_method")
  amount            Decimal       @db.Decimal(12, 2)
  allocatedAmount   Decimal       @default(0.00) @map("allocated_amount") @db.Decimal(12, 2)
  unallocatedAmount Decimal       @default(0.00) @map("unallocated_amount") @db.Decimal(12, 2)

  referenceNumber String?               @map("reference_number")
  bankName        String?               @map("bank_name")
  chequeDate      DateTime?             @map("cheque_date")
  notes           String?
  status          CustomerPaymentStatus @default(POSTED)

  postedAt           DateTime  @default(now()) @map("posted_at")
  postedByUserId     String?   @map("posted_by_user_id")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledByUserId  String?   @map("cancelled_by_user_id")
  cancellationReason String?   @map("cancellation_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  postedByUser    User?        @relation("CustomerPaymentPostedBy", fields: [postedByUserId], references: [id], onDelete: SetNull)
  cancelledByUser User?        @relation("CustomerPaymentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  allocations   CustomerPaymentAllocation[]
  ledgerEntries CustomerLedgerEntry[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, customerId, paymentDate])
  @@map("customer_payments")
}

/// Invoice Allocation breakdown for standalone payments
model CustomerPaymentAllocation {
  id                String   @id @default(uuid())
  customerPaymentId String   @map("customer_payment_id")
  salesInvoiceId    String   @map("sales_invoice_id")
  amountAllocated   Decimal  @map("amount_allocated") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  customerPayment CustomerPayment @relation(fields: [customerPaymentId], references: [id], onDelete: Cascade)
  salesInvoice    SalesInvoice    @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)

  @@index([customerPaymentId])
  @@index([salesInvoiceId])
  @@map("customer_payment_allocations")
}

// ==========================================
// SALES RETURNS & RESTOCKING MODELS
// ==========================================

enum SalesReturnStatus {
  POSTED
  CANCELLED
}

enum ReturnReason {
  CUSTOMER_RETURN
  DAMAGED_IN_TRANSIT
  DEFECTIVE_PRODUCT
  EXPIRED_NEAR_EXPIRY
  WRONG_DISPENSATION
  REGULATORY_RECALL
  OTHER
}

enum ReturnedStockCondition {
  SALEABLE // Restocked into STANDARD warehouse for resale
  QUARANTINED // Restocked into QUARANTINE warehouse
}

enum ReturnRefundMode {
  CREDIT_ACCOUNT // Store credit / receivable deduction
  CASH_REFUND // Immediate cash payout (bounded by amount actually paid)
  BANK_TRANSFER // Immediate bank transfer payout (bounded by amount actually paid)
}

/// Sales Return / Credit Note Header
model SalesReturn {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  branchId       String            @map("branch_id")
  customerId     String            @map("customer_id")
  salesInvoiceId String            @map("sales_invoice_id")
  returnNumber   String            @map("return_number") // Sequential (DocumentType.SALES_RETURN)
  returnDate     DateTime          @default(now()) @map("return_date")
  status         SalesReturnStatus @default(POSTED)
  reason         ReturnReason      @default(CUSTOMER_RETURN)

  refundMode   ReturnRefundMode @default(CREDIT_ACCOUNT) @map("refund_mode")
  refundAmount Decimal          @default(0.00) @map("refund_amount") @db.Decimal(12, 2)

  // Financial Totals
  subtotal       Decimal @default(0.00) @map("subtotal") @db.Decimal(12, 2)
  discountAmount Decimal @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  netTotal       Decimal @default(0.00) @map("net_total") @db.Decimal(12, 2)
  totalCostPrice Decimal @default(0.00) @map("total_cost_price") @db.Decimal(12, 2) // COGS reversed
  grossProfit    Decimal @default(0.00) @map("gross_profit") @db.Decimal(12, 2)

  notes              String?
  postedAt           DateTime  @default(now()) @map("posted_at")
  postedByUserId     String?   @map("posted_by_user_id")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledByUserId  String?   @map("cancelled_by_user_id")
  cancellationReason String?   @map("cancellation_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesInvoice    SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  postedByUser    User?        @relation("SalesReturnPostedBy", fields: [postedByUserId], references: [id], onDelete: SetNull)
  cancelledByUser User?        @relation("SalesReturnCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  items         SalesReturnItem[]
  ledgerEntries CustomerLedgerEntry[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId, branchId, returnDate])
  @@index([salesInvoiceId])
  @@index([customerId])
  @@map("sales_returns")
}

/// Sales Return Line Item (Discrete batch restored to exact warehouse location)
model SalesReturnItem {
  id                     String   @id @default(uuid())
  salesReturnId          String   @map("sales_return_id")
  salesInvoiceItemId     String   @map("sales_invoice_item_id")
  productId              String   @map("product_id")
  batchId                String   @map("batch_id")
  batchNumber            String   @map("batch_number")
  expiryDate             DateTime @map("expiry_date")
  destinationWarehouseId String   @map("destination_warehouse_id")

  returnedQuantity      Int @map("returned_quantity")
  bonusReturnedQuantity Int @default(0) @map("bonus_returned_quantity")
  totalReturnedQuantity Int @map("total_returned_quantity")

  stockCondition     ReturnedStockCondition @default(SALEABLE) @map("stock_condition")
  unitCost           Decimal                @map("unit_cost") @db.Decimal(12, 2)
  unitPrice          Decimal                @map("unit_price") @db.Decimal(12, 2)
  discountPercentage Decimal                @default(0.00) @map("discount_percentage") @db.Decimal(5, 2)
  discountAmount     Decimal                @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxPercentage      Decimal                @default(0.00) @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount          Decimal                @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal          Decimal                @map("line_total") @db.Decimal(12, 2)
  lineCost           Decimal                @map("line_cost") @db.Decimal(12, 2)
  lineProfit         Decimal                @map("line_profit") @db.Decimal(12, 2)

  salesReturn          SalesReturn      @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  salesInvoiceItem     SalesInvoiceItem @relation(fields: [salesInvoiceItemId], references: [id], onDelete: Restrict)
  product              Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch                Batch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse        @relation(fields: [destinationWarehouseId], references: [id], onDelete: Restrict)

  @@index([salesReturnId])
  @@index([salesInvoiceItemId])
  @@map("sales_return_items")
}

enum StockTransferStatus {
  DRAFT
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Stock Transfer between warehouses
model StockTransfer {
  id                     String              @id @default(uuid())
  organizationId         String              @map("organization_id")
  branchId               String              @map("branch_id")
  transferNumber         String              @map("transfer_number")
  sourceWarehouseId      String              @map("source_warehouse_id")
  destinationWarehouseId String              @map("destination_warehouse_id")
  transferDate           DateTime            @default(now()) @map("transfer_date")
  status                 StockTransferStatus @default(DRAFT)
  notes                  String?

  createdById         String?   @map("created_by_id")
  dispatchedById      String?   @map("dispatched_by_id")
  dispatchedAt        DateTime? @map("dispatched_at")
  receivedById        String?   @map("received_by_id")
  receivedAt          DateTime? @map("received_at")
  cancelledById       String?   @map("cancelled_by_id")
  cancelledAt         DateTime? @map("cancelled_at")
  cancellationReason  String?   @map("cancellation_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch               Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sourceWarehouse      Warehouse    @relation("SourceStockTransfers", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse    @relation("DestinationStockTransfers", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  createdByUser        User?        @relation("StockTransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  dispatchedByUser     User?        @relation("StockTransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  receivedByUser       User?        @relation("StockTransferReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  cancelledByUser      User?        @relation("StockTransferCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  items StockTransferItem[]

  @@unique([organizationId, transferNumber])
  @@index([organizationId, branchId, transferDate])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@map("stock_transfers")
}

/// Stock Transfer Line Item
model StockTransferItem {
  id                 String   @id @default(uuid())
  stockTransferId    String   @map("stock_transfer_id")
  productId          String   @map("product_id")
  batchId            String   @map("batch_id")
  batchNumber        String   @map("batch_number")
  expiryDate         DateTime @map("expiry_date")
  requestedQuantity  Int      @map("requested_quantity")
  dispatchedQuantity Int      @default(0) @map("dispatched_quantity")
  receivedQuantity   Int      @default(0) @map("received_quantity")
  unitCost           Decimal  @map("unit_cost") @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch         Batch         @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([stockTransferId])
  @@index([productId])
  @@index([batchId])
  @@map("stock_transfer_items")
}

enum RecallSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecallStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

/// Product Recall model (batch-specific recall management)
model ProductRecall {
  id                 String         @id @default(uuid())
  organizationId     String         @map("organization_id")
  recallNumber       String         @map("recall_number")
  productId          String         @map("product_id")
  batchId            String         @map("batch_id")
  reason             String
  severity           RecallSeverity @default(HIGH)
  status             RecallStatus   @default(OPEN)
  recallDate         DateTime       @default(now()) @map("recall_date")
  notes              String?

  createdById        String?        @map("created_by_id")
  resolvedById       String?        @map("resolved_by_id")
  resolvedAt         DateTime?      @map("resolved_at")
  cancelledById      String?        @map("cancelled_by_id")
  cancelledAt        DateTime?      @map("cancelled_at")
  cancellationReason String?        @map("cancellation_reason")

  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  createdByUser  User?        @relation("RecallCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedByUser User?        @relation("RecallResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  cancelledByUser User?       @relation("RecallCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@unique([organizationId, recallNumber])
  @@index([organizationId, productId])
  @@index([batchId])
  @@index([status])
  @@map("product_recalls")
}


