# Medix Backend Environment Configuration

# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medix_db?schema=public"

# CORS Configuration (comma-separated origins or * for open dev)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Logging
LOG_LEVEL=debug

# JWT Authentication Secrets (Must be random, secure keys in production)
JWT_ACCESS_SECRET="generate_a_secure_random_access_key_min_16_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="generate_a_secure_random_refresh_key_min_16_chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Initial Administrator Bootstrap (Password is required for first-time setup only)
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_DISPLAY_NAME="System Administrator"
